PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant-tracker
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Use a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7

# Used only when the database has no users yet.
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Production only.
# - NODE_ENV must be "production" to enable secure cookies, CORS checks,
#   and serving of the built frontend (dist) from Express.
# - CLIENT_ORIGIN must be the deployed frontend URL (comma-separated if multiple).
# - FRONTEND_DIST (optional) overrides the path to the built frontend,
#   e.g. FRONTEND_DIST=/var/www/app/dist
